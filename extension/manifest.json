{
  "manifest_version": 3,
  "name": "Opportunity — Conversation Capture",
  "version": "1.0.0",
  "description": "Save an AI conversation you are reading to your own Opportunity Command Center.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_title": "Save to Opportunity",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://chat.openai.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
