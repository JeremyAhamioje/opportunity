# ---------------------------------------------------------------------------
# Copy to .env.local. Every value here is optional — the app runs with none of
# them set. Never put real values in this file; it is committed.
# ---------------------------------------------------------------------------

# Postgres connection string. Leave unset to use the embedded PGlite database
# in ./.pglite (real Postgres, no install, single writer). Set it to move to a
# hosted server — Supabase, Neon, RDS:
#   postgres://user:password@host:5432/postgres
# The schema and every query are identical either way, and migrations run on
# first request. Required if you deploy: serverless hosts have no persistent
# local disk, so PGlite cannot be used there.
# DATABASE_URL=

# Session signing key. Required in production; locally a random one is generated
# into .auth-secret on first run. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# Optional. Adds "Extract with Gemini" to Research Import for prose the built-in
# parser cannot structure. The parser works with this unset.
# GEMINI_API_KEY=

# gemini-3.7-flash returns 503 "high demand" on this key (checked 2026-08-28) and
# gemini-3.6-flash rejects the request config with 400. 2.5-flash answers in ~2.6s;
# 3.5-flash works too but takes ~33s, which is too long to sit behind the loader.
# Switch back to gemini-3.7-flash once it has capacity — this line is the only change.
# GEMINI_MODEL_ID=gemini-2.5-flash

# Optional. Enables emailed reminder digests via Resend. Without it the app is
# unchanged — reminders still work everywhere in the UI; they just do not leave
# the building. Get a key at resend.com.
# RESEND_API_KEY=

# Sender address. Until a domain is verified in the Resend dashboard,
# `onboarding@resend.dev` is the only sender that works, and it can only deliver
# to the Resend account owner's own address. Verify a domain to send anywhere.
# EMAIL_FROM=Opportunity <onboarding@resend.dev>

# Bearer token protecting POST /api/cron/digest, which is what an external
# scheduler calls to send the daily digest. Unset means the endpoint refuses
# every request. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# CRON_SECRET=

# Optional. Adds "Discover" to Research Import: run a Google search through
# SerpApi and turn the results into draft opportunities. The paste path works
# without it. Free tier is ~100 searches/month; each run spends one credit.
# SERPAPI_KEY=
